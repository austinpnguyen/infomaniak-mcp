# Copy to .env and fill in. Never commit the filled copy.

# The internal account id, not the mailbox address. Find it in the Apple
# configuration profile that kSuite generates under
# Contacts -> Synchronise your contacts on all your devices.
INFOMANIAK_USER=AB12345

# Generated in the Infomaniak manager under My Profile -> Application password(s).
# One per account. A password made in one account will not work in another.
INFOMANIAK_APP_PASSWORD=

# Optional
# INFOMANIAK_DAV_URL=https://sync.infomaniak.com
# INFOMANIAK_ADDRESSBOOK=
# INFOMANIAK_CALENDAR=
